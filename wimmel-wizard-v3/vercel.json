{
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/app/:path*", "destination": "/app.html" },
    { "source": "/gutschein", "destination": "/gutschein.html" },
    { "source": "/gutschein/danke", "destination": "/gutschein-danke.html" },
    { "source": "/einloesen", "destination": "/einloesen.html" },
    { "source": "/widerruf", "destination": "/widerruf.html" },
    { "source": "/impressum", "destination": "/rechts/impressum.html" },
    { "source": "/agb", "destination": "/rechts/agb.html" },
    { "source": "/widerrufsbelehrung", "destination": "/rechts/widerrufsbelehrung.html" },
    { "source": "/datenschutz", "destination": "/rechts/datenschutz.html" }
  ],
  "functions": {
    "api/fal-proxy.js": { "maxDuration": 300 },
    "api/claude-proxy.js": { "maxDuration": 300 },
    "api/transcribe-proxy.js": { "maxDuration": 300 },
    "api/image-proxy.js": { "maxDuration": 30 },
    "api/char-job-start.js": { "maxDuration": 30 },
    "api/char-job-status.js": { "maxDuration": 30 },
    "api/scene-job-start.js": { "maxDuration": 30 },
    "api/scene-job-status.js": { "maxDuration": 30 },
    "api/session.js": { "maxDuration": 30 },
    "api/gutschein.js": { "maxDuration": 30, "includeFiles": "{api/_assets/**,public/rechts/**}" },
    "api/stripe-webhook.js": { "maxDuration": 60, "includeFiles": "{api/_assets/**,public/rechts/**}" },
    "api/cron/gutschein-zustellung.js": { "maxDuration": 120, "includeFiles": "{api/_assets/**,public/rechts/**}" }
  },
  "crons": [
    { "path": "/api/cron/gutschein-zustellung", "schedule": "0 7 * * *" }
  ]
}
